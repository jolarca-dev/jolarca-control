[Unit]
Description=Daily jolarca-control state backup, backfilled on the next session when the window is missed
Documentation=file:///opt/jolarca/repos/jolarca-control/AGENTS.md
# Source of truth: install with `make backup-timer-install`. See the .service file
# beside this one for why that matters.

[Timer]
OnCalendar=*-*-* 09:17:00
# Persistent=true is the whole reason this replaced a crontab entry. The crontab line
# installed 2026-10-27 never fired: the host was suspended across 04:17 on 2026-10-28
# and user crontabs do not backfill (anacron covers only the system cron directories).
# Measured by zero CRON syslog entries 04:00-06:00, a five-minute heartbeat gap
# 00:25 -> 19:05, and "Stopped target suspend.target" on resume.
Persistent=true
Unit=jolarca-state-backup.service

[Install]
WantedBy=timers.target

# CADENCE, MEASURED. The window was 04:17 from install until 2026-10-30 and it was reached on NEITHER
# 2026-10-29 nor 2026-10-30: the host is asleep (zero CRON heartbeat entries 03:00-05:59 both nights), so
# Persistent=true fired on first login instead -- 21:22 on the 30th, which failed on a backend race and
# succeeded on the retry two minutes later. 09:17 was chosen on a FRIDAY observation ("the host is awake
# mid-morning") that a SATURDAY falsified: 2026-10-31 had zero CRON heartbeat entries 08:00-10:59 and the
# job backfilled at 12:12:45, whose first attempt failed and retried to success at 12:14:45. No configured
# window has ever fired on time; every run to date is a session-start catch-up.
#
# What does NOT change: a day with no login and no resume is a day with no backup. The guarantee is "one
# verified copy per session, backfilled on resume", never "every night at HH:MM". Read the value on the
# OnCalendar= line above rather than from AGENTS.md -- that sentence has gone stale five times chasing
# this one line, which is why it no longer carries the number.
#
# RESIDUAL GAP, recorded rather than hidden: this is a USER timer, so it only runs while
# the user's systemd manager exists. `loginctl show-user jol --property=Linger` measured
# `no` on 2026-10-28, which means a reboot with nobody logged in runs nothing at all --
# a different failure, not a smaller one. Close it with either
#   sudo loginctl enable-linger jol
# or by installing these two units under /etc/systemd/system with User=jol.
