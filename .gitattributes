# ──────────────────────────────────────────────────────────────────────────────
# .gitattributes — jolarca-control (Python + Terraform)
# ──────────────────────────────────────────────────────────────────────────────

# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicitly mark binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.tfstate binary

# Python — LF, utf-8
*.py text diff=python
*.pyi text diff=python

# Terraform — LF, utf-8
*.tf text diff=hcl
*.tfvars text diff=hcl
*.hcl text diff=hcl

# YAML / JSON / Markdown
*.yml text
*.yaml text
*.json text
*.md text

# Shell scripts — LF (no CRLF)
*.sh text eol=lf
*.bash text eol=lf

# Terraform state — treat as binary, never diff
*.tfstate.* binary

# Lock files — commit but don't diff
*.lock text

# Anchor-collision steering for the changelog.
# CHANGELOG.md is append-at-anchor: every PR inserts its "### ..." section directly after
# "## [Unreleased]", so two open PRs always collide at that one line and the resolution is
# always "keep both". Proven in a scratch clone 2026-10-27: without this driver the merge
# exits 1 with a conflict region; with it, exit 0 and both sections survive.
# The driver's own failure mode is that it never conflicts -- if two branches edit the SAME
# line, union keeps both copies silently. tests/test_changelog_anchor.py is what makes that
# loud instead of quiet; do not remove the test when removing this line, or vice versa.
CHANGELOG.md merge=union
